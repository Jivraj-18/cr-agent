{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python:*)",
      "Bash(../.venv/bin/python:*)",
      "Bash(python:*)",
      "Bash(adb devices)",
      "Bash(adb connect:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(adb shell:*)",
      "Bash(adb install:*)",
      "Bash(adb uninstall:*)",
      "Bash(adb push:*)",
      "Bash(adb pull:*)",
      "Bash(adb exec-out:*)",
      "Bash(adb root:*)",
      "Bash(adb tcpip:*)",
      "Bash(adb pair:*)",
      "Bash(adb kill-server:*)",
      "Bash(rm -rf:*)",
      "Bash(termux-setup-storage:*)",
      "Read(/sdcard/**)",
      "Read(/storage/**)",
      "Read(~/.ssh/**)",
      "Edit(.claude/settings.json)"
    ]
  }
}
